# Local FastAPI backend:  uvicorn api.index:app --reload --port 3001
#
# Keep this as localhost — the app swaps the host for your machine's LAN IP at
# runtime (it reads it from the Metro dev server), so there's no IP to update
# when you change networks. The port here is the one that gets used.
#
# Set a real host to override that: a LAN IP, or a deployed URL, is used as-is.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
